# Allowlist. Everything is ignored; only the files a fresh clone needs in
# order to run are re-included below. Add new run files here explicitly.
*

# Descend into directories so the rules below can match inside them.
# (Git tracks files, not directories, so this adds nothing by itself.)
!*/

# --- github metadata ---------------------------------------------------
!/.github/FUNDING.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/1_bug.md
!/.github/ISSUE_TEMPLATE/2_improvement.md
!/.github/ISSUE_TEMPLATE/3_feature_request.md

# --- top level ---------------------------------------------------------
!/.gitignore
!/LICENSE
!/README.md
# the serving profile. /.env itself stays ignored: it may hold HF_TOKEN.
!/.env.sample
!/start.sh
!/stop.sh

# --- launcher support and patch generators -----------------------------
!/files/memwatch.sh
!/files/build_ple_packed_table.py
!/files/patch_ple_layer.py
!/files/patch_modelopt_mxfp8.py
!/files/patch_ple_offload.py
!/files/patch_qsa_fp8_kv.py

# --- benchmarks --------------------------------------------------------
!/bench/decodebench.py
!/bench/longctx.py

# Deliberately NOT tracked:
#   .env                      may contain HF_TOKEN
#   HANDOFF.md, docs/         host-specific notes, not needed to run
#   logs/, *.log              runtime output
#   .last_launch.sh           regenerated by start.sh --no-launch
#   files/*.orig,             upstream vLLM sources; start.sh extracts them
#   files/ple_offload/orig/     from the image on first run
#   files/ple_layer_patched.py, files/modelopt_patched.py,
#   files/ple_offload/*.py    generated from the .orig copies on every launch
