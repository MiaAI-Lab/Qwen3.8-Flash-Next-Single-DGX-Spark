# .env.sample — single-Spark (TP=1) deployment. Copy to .env and edit.
IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
# HF_TOKEN=""                       # required for ABLIT=1 (gated Hugging Face repo).
                                    # Uncomment and set it, then accept the terms on
                                    # https://huggingface.co/drowzeys/keys-Qwen3.8-flash-next-ablit-Mia-Single-Spark-only

# Known-good serving profile (measured 2026-09-04 on this host). Every value
# can be overridden from the environment: MAX_MODEL_LEN=65536 ./start.sh
ABLIT=0                             # 0 = stock Mia NVFP4, 1 = gated abliterated
                                    # checkpoint (Keys QSA o_proj L15-47). Accept the
                                    # Hugging Face terms first, then ABLIT=1 ./download.sh
                                    # (~99 GiB full snapshot, same size as stock).
                                    # HF_TOKEN required.
# TP1_MODEL_ID="nvidia/Qwen3.8-Flash-Next-NVFP4"
                                    # Explicit checkpoint override (same as ./download.sh
                                    # Org/Some-Other-Model / ./start.sh with TP1_MODEL_ID set).
                                    # Verified against NVIDIA's official mixed-precision
                                    # quant (124 GiB, MSE-calibrated NVFP4 routed experts,
                                    # BF16 attention/shared-experts, FP8 MTP) as an
                                    # alternative to the stock Mia checkpoint above. Its PLE
                                    # n-gram table is plain per-tensor FP8 (not the stock
                                    # NVFP4-coded/scaled shards) and its MTP MoE experts
                                    # declare ModelOpt's FP8_PB_WO (128x128 block-scaled)
                                    # quant_algo under the draft model's own local layer
                                    # index -- both handled by build_ple_packed_table.py and
                                    # patch_modelopt_mxfp8.py respectively; see
                                    # tests/test_nvidia_ple.py and tests/test_nvidia_mtp.py.
                                    # Real PLE table is 47.68 GiB, not the 26.82 default
                                    # below -- set PLE_GIB accordingly or the pre-flight
                                    # budget check overstates GPU weight usage. Its GPU-side
                                    # weights are ~76 GiB against the stock ~72, so it also
                                    # wants HOST_RESERVE_GIB=30 and MTP_WEIGHTS_GIB=2.34;
                                    # both are explained where they are defined below.
# PLE_GIB=47.68                      # Override for TP1_MODEL_ID checkpoints whose PLE table
                                    # size differs from the stock default. Measured directly
                                    # (build_ple_packed_table.py output size), not estimated:
                                    # get it wrong and the pre-flight memory check in step 2
                                    # of start.sh will be wrong too, in either direction.
# MTP_WEIGHTS_GIB=2.34               # GiB of MTP draft weights packed into the same file as
                                    # the PLE table, so PLE_GIB does not subtract them.
                                    # Credited back to the derived GPU figure only at
                                    # MTP_NUM_SPECULATIVE_TOKENS=0, where the draft model is
                                    # never loaded; at MTP > 0 nothing changes. Leave unset
                                    # (0) for the stock checkpoint, whose draft weights are
                                    # not packed with the PLE shards. Measured on NVIDIA's
                                    # checkpoint from the safetensors header of
                                    # model-fp8-mtp-ple.safetensors: 50.03 GiB total =
                                    # 47.68 PLE + 2.34 MTP. Its only effect is on what the
                                    # pre-flight prints and on the "KV needed" safety check
                                    # -- when HOST_RESERVE_GIB caps the budget (it does on a
                                    # 121 GiB host) the granted pool is unchanged, because
                                    # vLLM sizes that from its own profiling. Measured
                                    # 2026-09-17, MTP off, NVIDIA checkpoint: predicted KV
                                    # 14.11 GiB without it vs 16.45 with, against 19.34 GiB
                                    # actually available. Still conservative, less so.
YARN=0                              # 0 = native rope (uses MAX_MODEL_LEN), 1 = YaRN (uses YARN_MAX_MODEL_LEN)
MAX_MODEL_LEN=262144                # context at YARN=0; cannot exceed the native 262144
YARN_MAX_MODEL_LEN=524288           # context at YARN=1; ignored when YARN=0. Ceiling 524288
MTP_NUM_SPECULATIVE_TOKENS=3        # 0 disables MTP (saves 1.5 GiB)
KV_TARGET_GIB=20                    # KV wish, GiB. A wish, not a grant: the GPU budget is capped at
                                    # MemTotal - HOST_RESERVE_GIB, and start.sh prints "KV target X
                                    # reduced to Y" when the cap binds. It binds here. Measured
                                    # 2026-09-06 over ten launches: 20 -> 16.67 GiB every time (18.16
                                    # with MTP off, which frees the draft weights), GMU 0.786 =
                                    # 95.60 GiB budget, and 15.98 GiB = 1,132,586 FP8 tokens left
                                    # after vLLM's own profiling on the final launch (the pool varies
                                    # ~10% between restarts). Host MemAvailable stayed at or above
                                    # 13.0 GiB through the decode sweeps and 15.5-16.4 GiB across a
                                    # 45 min soak, with 0 NV_ERR_NO_MEMORY. On a host with more
                                    # memory the cap is looser and 20 may be granted in full:
                                    # HOST_RESERVE_GIB, not this line, is what protects the host.
                                    # 22 (the old default) idled the host at 6.9-8.8 GiB MemAvailable
                                    # against a 6 GiB watchdog floor and the NVIDIA driver refused
                                    # allocations there: three servers lost on 2026-09-04.
HOST_RESERVE_GIB=26                 # GPU budget cap = MemTotal - this. Co-tenants ~7 + vLLM host side ~6 + PLE cache >=6 + driver free pages >=3 + growth
                                    # Raise to 30 for TP1_MODEL_ID=nvidia/Qwen3.8-Flash-Next-NVFP4.
                                    # Its GPU-side weights are ~76 GiB against the stock ~72,
                                    # and that 4 GiB is the headroom capture was spending.
                                    # Measured 2026-09-17 at 26 on a 121.69 GiB host: the
                                    # driver peaked at 101.1 GiB against a 95.65 GiB budget,
                                    # MemFree bottomed at 1.07 GiB and the kernel logged 12
                                    # NV_ERR_NO_MEMORY during CUDA graph + speculator capture.
                                    # Nothing died and serving was clean, but that is the
                                    # margin three servers were lost on in 2026-09-04. The
                                    # same boot at MTP 0, which skips speculator capture,
                                    # peaked at 97.4 GiB with 2 events -- so most of the
                                    # overshoot is speculative decoding's capture step, and
                                    # no --gpu-memory-utilization value bounds it.
                                    # Re-measured at 30, same checkpoint and profile: budget
                                    # 91.63 GiB (GMU 0.753), driver peaked at 90.63 -- a GiB
                                    # under the budget rather than 5.5 over -- 3 events left,
                                    # all during KV allocation rather than capture. KV 9.48
                                    # GiB = 570,099 FP8 tokens, still 2.17x concurrency at
                                    # 262144. Single-stream decode went UP, 23.07 -> 24.78
                                    # tok/s over three runs: the smaller pool costs nothing
                                    # here and the host stops fighting the driver for pages.
                                    #
                                    # RESERVE TABLE (all on this 121.69 GiB host; the three
                                    # notes elsewhere in this file corroborate, they do not
                                    # conflict -- same ceiling measured from two directions:
                                    # ~103 GiB driver / <2 GiB MemFree at MAX_NUM_SEQS=8 on
                                    # stock; 101.1 GiB / 1.07 GiB free at MTP 3 on NVIDIA):
                                    #   stock Mia checkpoint, MAX_NUM_SEQS=4  -> 26
                                    #   stock Mia checkpoint, MAX_NUM_SEQS=8  -> 28 (graph-capture
                                    #       spike, 8 verify widths; measured 2026-09-11)
                                    #   NVIDIA checkpoint, MAX_NUM_SEQS=4, MTP 3 -> 30 (+ set
                                    #       PLE_GIB=47.68 and MTP_WEIGHTS_GIB=2.34; measured
                                    #       2026-09-17; MTP 0 measured clean-ish at 28 but 30
                                    #       keeps the margin that 2026-09-04 lost servers on)
                                    #   NVIDIA checkpoint, MAX_NUM_SEQS=8, MTP 3 -> 30 (measured
                                    #       2026-09-18, both bumps at once: peak driver 98.3 GiB
                                    #       against the 91.63 budget -- the same capture-spike
                                    #       overshoot #47 saw, absorbed by the reserve; MemFree
                                    #       floor 12.05 GiB, never near the 2 GiB watchdog
                                    #       floor; 2 NV_ERR_NO_MEMORY, both at engine init before
                                    #       shard load, 0 through capture + serving + C4
                                    #       benchmark bursts; KV 8.87 GiB = 591,654 tokens =
                                    #       2.26x at 262144. 30 covers both bumps.)
                                    # Anything the watchdog emergency-stops is a failed
                                    # configuration regardless of its tok/s.
KV_CACHE_DTYPE=fp8                  # fp8 = ~1.85x KV pool, enables a 1M context.
                                    # Set to auto/bfloat16 for BF16 KV. Measured here:
                                    # Measured: -2.7% prefill @400k, -6.1% @32k, -4%
                                    # decode, 11/11 on the reasoning suite (same as BF16).
MAMBA_SSM_CACHE_DTYPE=bfloat16      # dtype of the GDN recurrent (SSM) state. The checkpoint asks for
                                    # float32; the fused GDN kernel also takes bfloat16
                                    # (FUSED_GDN_STATE_DTYPES). Halves the ~0.23 GB per sequence the
                                    # state moves every step and halves the mamba page, which drops
                                    # the attention block from 3,200 to 1,664 tokens. Measured
                                    # 2026-09-06 on this host: +8.5% aggregate decode at 8 streams
                                    # (151.6 -> 164.5 tok/s), +6.8% at 1, step 141.4 -> 130.4 ms at 8
                                    # with acceptance unchanged; needles 15/15 at 32k, same as
                                    # float32; 4-turn continuation shows no recurrence drift.
                                    # Empty keeps the checkpoint's float32.
MAX_NUM_SEQS=4                      # concurrent sequences (see README for KV headroom). The KV
                                    # pool holds 3.79x a full 262k request, so this is the
                                    # long-context limit, not a throughput knob. Aggregate decode
                                    # keeps rising well past it on short contexts (measured
                                    # 2026-09-05: 84.7 tok/s at 5 streams, 114 at 8; re-measured
                                    # 2026-09-06 with every verify width captured as a FULL graph:
                                    # 162.9 tok/s at 8 streams against 113.7 at 4, host
                                    # MemAvailable never below 16.1 GiB) but 8 concurrent 262k
                                    # requests do not fit the KV pool, and the 2026-09-06 sweeps
                                    # were all short-context. Raise it for throughput on short
                                    # requests; leave it at 4 if your traffic is long-context.
                                    # WARNING: at 8, pair it with HOST_RESERVE_GIB=28. Measured
                                    # 2026-09-11 on this host: at HOST_RESERVE_GIB=26 the
                                    # graph-capture spike (8 verify widths instead of 4) pushed
                                    # the driver to ~103 GiB, MemFree under 2 GiB, 3
                                    # NV_ERR_NO_MEMORY, and the watchdog emergency-stopped the
                                    # launch. At 28 the same launch came up clean (KV 14.60 GiB
                                    # = ~917k FP8 tokens, still ~3.5 full 262k contexts).
CUDAGRAPH_CAPTURE_SIZES=auto        # decode CUDA graph widths. "auto" captures every (1+MTP)*S for
                                    # S in 1..MAX_NUM_SEQS -- i.e. every verify batch the scheduler
                                    # can actually build. vLLM's own list is [1,2,4]+multiples of 8
                                    # filtered to <= (1+MTP)*MAX_NUM_SEQS, which at MTP 3 leaves
                                    # keys {4,8,16}: a 3-sequence batch (12 tokens) pads up to 16
                                    # and a 5-sequence batch (20 tokens) has no graph at all and
                                    # decodes eager. Empty keeps vLLM's list. A comma list sets
                                    # them explicitly. Capture costs ~1 s and a few MiB per size.
MAX_NUM_BATCHED_TOKENS=2048         # prefill chunk width. Raising this to 8192 buys ~11% prefill
                                    # and ~10% off TTFT, paid for out of the KV pool (~3%).
                                    # See the README prefill table before changing it.
MTP_DRAFT_VOCAB=files/draft_vocab_en_code_47k.txt
                                    # Reduced-vocabulary drafting (FR-Spec): host path to a file of
                                    # token ids, one per line. The shipped 47,172-row code-tuned vocab
                                    # shrinks the MTP draft head from 1.18 GiB to 0.22 GiB, saving
                                    # ~2.9 GiB per MTP-3 engine step. The +25% decode win was measured
                                    # on this host with the 65k en+code vocab (76.9 -> 63.9 ms/step
                                    # single-stream; MGSM en 94.8% vs 93.6%, zh 86.4% vs 86.4%).
                                    # Correctness is structural (rejection sampling rejects drafts
                                    # outside the subset, never wrong output); poor coverage only
                                    # costs speed. This file: 47,172 ids from 30 MiB host code+docs
                                    # (8.9M tokens, 100% corpus coverage, 99.58% held-out). Empty
                                    # restores the full 248k head. Rebuild: files/build_draft_vocab.py
                                    # (pins all 256 byte-level fallback ids unconditionally, so
                                    # accented Latin / CJK / emoji drafting survives small or
                                    # narrow corpora; the shipped file carries the 23 of them
                                    # that English frequency alone did not keep).
                                    # SERVING SPANISH: use files/draft_vocab_es_en_code_65k.txt
                                    # instead — the 47k file whole as floor plus 668 MiB of
                                    # Spanish Wikipedia at 65,536 rows. Measured (interleaved
                                    # ABBA, docs/spanish-drafting-and-performance-2026-09-13.md):
                                    # Spanish 32.6 -> 41.9 tok/s (+28.6%), English unchanged,
                                    # for 9% of the draft-head byte saving. The 47k file covers
                                    # only 64% of Spanish output occurrences (acceptance ~1.0);
                                    # quality is fine either way (rejection sampling), this is
                                    # purely the speed of Spanish traffic.
CHAT_TEMPLATE=                      # replacement Jinja chat template (host path), mounted into the
                                    # container read-only. Empty keeps the checkpoint's stock
                                    # template (paired with --tool-call-parser qwen3_coder).
                                    # The shipped alternative is froggeric's v22.5 fixed template
                                    # (files/chat-template/chat_template.jinja, Apache-2.0,
                                    # hf.co/froggeric/Qwen-Fixed-Chat-Templates): it fixes the
                                    # stock template's raise_exception on reasoning_effort aliases
                                    # ("high"/"minimal"/"none" from OpenAI/Claude Code/Cline
                                    # clients), its crash on stringified-JSON tool arguments in
                                    # history, and the xhigh-by-default reasoning token burn, and
                                    # adds inline <|think_off|>/<|think_low|>/<|think_xhigh|> tags.
                                    # Setting CHAT_TEMPLATE also switches the tool parser to
                                    # qwen3_xml (the template emits canonical XML tool calls).
                                    # Verified 2026-09-11 on this host: enable_thinking=false,
                                    # stringified-JSON args, effort aliases and inline tags all
                                    # pass; decode throughput unchanged (template is prompt-side).
                                    # Client note: with thinking off via <|think_off|> or
                                    # reasoning_effort="none", short answers land in
                                    # reasoning_content (vLLM qwen3 parser + prefilled closed
                                    # think block); explicit enable_thinking=false routes to
                                    # content correctly. Prefer the kwarg on vLLM.
MTP_K_SCHEDULE=                      # dynamic speculative depth, "start:end:K,..." over inclusive
                                    # batch-size ranges (e.g. "1:2:3,3:5:2,6:8:1"). Empty keeps a
                                    # constant MTP_NUM_SPECULATIVE_TOKENS, which is what you want:
                                    # the static sweep on 2026-09-06 (K=0/1/2/3 at S=1/2/4/8, FULL
                                    # graphs throughout) found K=3 optimal at every concurrency,
                                    # with K=2 tied and K=1 losing 8-14%. There is no crossover to
                                    # schedule. WARNING if you enable it anyway, measured
                                    # 2026-09-05: setting this makes vLLM override cudagraph_mode
                                    # from FULL_DECODE_ONLY to PIECEWISE, which cost +24% on the
                                    # single-stream step and drove the driver to 99.4 GiB against a
                                    # 94.87 GiB budget until the watchdog stopped the server. The
                                    # override comes from the draft model's config copy; pinning
                                    # VLLM_USE_V2_MODEL_RUNNER=1 (see EXTRA_DOCKER_ARGS) prevents
                                    # it, verified on every 2026-09-06 launch.
COMPILATION_MODE=0                  # torch.compile level. 0 = none (shipped). 3 = VLLM_COMPILE
                                    # (Inductor fusion). Measured 2026-09-06 with
                                    # CUDAGRAPH_MODE=FULL_AND_PIECEWISE: it loads, compiles in 13 s,
                                    # keeps FULL decode graphs and does not disturb the PLE custom
                                    # op -- and buys nothing (+0.3% at 1 stream, +1.0% at 4, both
                                    # inside noise). Decode here is bandwidth-bound, and fusion only
                                    # helps the part of the step that is not.
EXTRA_DOCKER_ARGS="-e VLLM_USE_V2_MODEL_RUNNER=1"
                                    # Pin the V2 model runner on every config copy. This
                                    # architecture already selects V2 for the target, but the
                                    # speculative draft copy (Qwen3_8FlashNextMTP) is not in the V2
                                    # default set, so it falls back to V1 and mutates the
                                    # compilation_config it shares with the target -- which is what
                                    # turned FULL decode graphs into PIECEWISE on 2026-09-05. The
                                    # pin was on for every 2026-09-06 launch, including the 45 min
                                    # soak, and no launch logged "Overriding cudagraph_mode".
HOST_SLACK_GIB=5                    # container cgroup cap = GPU budget + this
PORT=8888
# EXTRA_VLLM_ARGS=""                 # extra vLLM CLI args, word-split with SHELL-WORD
                                    # semantics: quoting inside the value is NOT supported
                                    # (no embedded quotes). Put heavy JSON via the dedicated
                                    # knobs (compilation-config, speculative-config) that
                                    # start.sh builds from scalars instead.

# BIND=0.0.0.0                       # Interface the API binds to. Every interface by default:
                                    # with no API_KEY / --api-key, start.sh prints a WARN listing
                                    # the exposed interfaces — anything that can reach the port
                                    # can reach the model. Set BIND=127.0.0.1 for loopback-only
                                    # (ssh-tunnel access). Migration: the behaviour changed from
                                    # loopback-only back to listening on every interface.
                                    # This default is a deliberate choice for an unattended
                                    # 24/7 box: the box is a server, and API_KEY is the
                                    # control — the launch-time WARN is a reminder, not a
                                    # guard. For a first-time install on a shared network,
                                    # prefer BIND=127.0.0.1 until API_KEY is set.
# API_KEY=""                         # Bearer token for the OpenAI API (--api-key). Empty = no
                                    # auth — and the default BIND=0.0.0.0 then exposes the model
                                    # on every interface (start.sh warns and lists them). Set it
                                    # whenever the port is reachable beyond this box. Clients
                                    # send: Authorization: Bearer <key>. The value is resolved at
                                    # launch time and never written to .last_launch.sh (same
                                    # hygiene as HF_TOKEN). The probe and smoke-test read it from
                                    # here automatically.
# READY_TIMEOUT_S=1800               # seconds the readiness loop waits for /health before it
                                    # archives + removes the wedged container and exits non-zero
                                    # (supervisor retriable). Cold start ~11 min, first boot longer.
# ALERT_WEBHOOK=""                   # generic webhook URL for alert.sh (supervisor relaunches,
                                    # emergencies, breaker trips, maintenance failures, daily
                                    # heartbeat). Payload {hostname,timestamp,message,container,
                                    # mem_available}. Examples: ntfy (https://ntfy.sh/<topic>),
                                    # telegram bridge. Empty = no-op, no failure.
# VLLM_QSA_DET_TOPK=                 # deterministic persistent_topk (vllm#55122). Needs a
                                    # compiled kernel .so on the image; plumbing-only, default unset.
# VLLM_MOE_DET_FINALIZE=             # bit-stable MoE finalize. Needs the FlashInfer autotune
                                    # cache-key backport; plumbing-only, default unset.
# GDN_DECODE_KERNEL=                 # VLLM_GDN_DECODE_KERNEL pass-through. The default CUDA
                                    # kernel deterministically hangs the engine at c≈32 with FP8
                                    # GDN projections. Unset for this release; flip to triton in a
                                    # later release only after a soak (needs to be bisectable).
# MTP_DISABLE_BLOCK_DROP=0           # 1 = merge "disable_eagle_block_drop":true into the
                                    # speculative-config JSON (vllm#53388): removes MTP's fixed
                                    # 1,600-token prefix-cache-block back-off per turn. Being
                                    # A/B-measured; not a default.
# VERIFY_SHA256=1                    # download.sh: sha256-verify every LFS blob against the HF
                                    # tree manifest (paginated). 0 documents a skip.
# QUANT_PREFLIGHT_DISABLED=0         # 1 = skip the per-launch quant_algo dispatch pre-flight
                                    # (throwaway container ~30 s). Keep enabled.
# MEMWATCH_TREND_GIB=4               # memwatch LEAK TREND line once/day when the `driver`
                                    # figure grows this much above its post-load baseline.
# MEMWATCH_TREND_WARMUP_S=900        # seconds before the LEAK TREND baseline window opens
                                    # (must outlast the ~10 min weight-load ramp).
# MEMWATCH_RELIEF=off                # drop_caches = before the MemFree floor stops the
                                    # container, drop clean page cache once (sudo -n, needs
                                    # a NOPASSWD rule, see files/memwatch.sh) and keep
                                    # sampling; stop only if MemFree stays low. kswapd at
                                    # stock watermarks reclaims only near 150 MiB free.
# MEMWATCH_RELIEF_AT=2               # sub-floor MemFree samples before the relief (< 5).
# MEMWATCH_RELIEF_MIN_GIB=1          # relief only when this much file cache is reclaimable.
# MEMWATCH_RELIEF_INTERVAL=60        # seconds between two reliefs at the most.
# STOPPING_MAX_AGE_S=7200            # supervisor: a logs/stopping flag older than this is
                                    # abandoned maintenance; it gets cleared + alerted instead
                                    # of holding the box down forever.

