# .env.sample — single-Spark (TP=1) deployment. Copy to .env and edit.
IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
# HF_TOKEN=""                       # only needed if the checkpoint is gated

# Known-good serving profile (measured 2026-09-04 on this host). Every value
# can be overridden from the environment: MAX_MODEL_LEN=65536 ./start.sh
YARN=0                              # 0 = native rope (uses MAX_MODEL_LEN), 1 = YaRN (uses YARN_MAX_MODEL_LEN)
MAX_MODEL_LEN=262144                # context at YARN=0; cannot exceed the native 262144
YARN_MAX_MODEL_LEN=524288           # context at YARN=1; ignored when YARN=0. Ceiling 524288
MTP_NUM_SPECULATIVE_TOKENS=3        # 0 disables MTP (saves 1.5 GiB)
KV_TARGET_GIB=20                    # ~20 GiB KV. 22 fits, but leaves so little host margin that
                                    # the memwatch floor can trip after hours of serving.
KV_CACHE_DTYPE=fp8                  # fp8 = ~1.85x KV pool, enables a 1M context.
                                    # Set to auto/bfloat16 for BF16 KV. Measured here:
                                    # Measured: -2.7% prefill @400k, -6.1% @32k, -4%
                                    # decode, 11/11 on the reasoning suite (same as BF16).
MAX_NUM_SEQS=4                      # concurrent sequences (see README for KV headroom)
HOST_SLACK_GIB=5                    # container cgroup cap = GPU budget + this
PORT=8888
